{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    },
    "preview-arm64": {
      "extends": "preview",
      "env": {
        "BANDLY_ARM64": "1"
      }
    },
    "ios-store": {
      "extends": "production",
      "channel": "preview"
    }
  },
  "submit": {
    "production": {},
    "ios-store": {}
  }
}
