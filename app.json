{
  "expo": {
    "name": "Bandly",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bandly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hasan.bandly",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "local": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "NSLocalNetworkUsageDescription": "Bandly يحتاج يوصل لراوترك على الشبكة المحلية عشان يقرأ الإشارة ويديره.",
        "NSMicrophoneUsageDescription": "Bandly يستخدم الميكروفون للمكالمات والرسائل الصوتية مع الفني أثناء ضبط الإشارة.",
        "NSCameraUsageDescription": "Bandly يستخدم الكاميرا لقراءة ملصق الراوتر، وأثناء المكالمة لما تشغّلها بنفسك عشان الفني يشوف الهوائي والراوتر."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2f6bff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hasan.bandly",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_PHONE_STATE"
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#2f6bff",
          "imageWidth": 190
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      "expo-notifications",
      "./plugins/withNetworkSecurity",
      [
        "expo-audio",
        {
          "microphonePermission": "Bandly يستخدم الميكروفون عشان ترسل رسائل صوتية للفني أثناء ضبط الإشارة.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Bandly يستخدم الكاميرا بس لما تشغّلها بنفسك أثناء المكالمة، عشان الفني يشوف الهوائي والراوتر ويوجّهك.",
          "microphonePermission": "Bandly يستخدم الميكروفون للمكالمات والرسائل الصوتية مع الفني."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bandly يستخدم الكاميرا لقراءة ملصق الراوتر، وأثناء المكالمة لما تشغّلها بنفسك عشان الفني يشوف الهوائي والراوتر.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withMlkitDeps"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94d7f449-28a0-4938-a3fc-d3572e1bd58e"
      }
    },
    "owner": "hassan14161",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/94d7f449-28a0-4938-a3fc-d3572e1bd58e",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
